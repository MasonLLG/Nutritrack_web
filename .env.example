# Copy this file to .env and fill in the values.
# .env is git-ignored; this example file is committed.

# ---- Database (required from Step 2 onward) ----
# MySQL / MariaDB connection string.
DATABASE_URL="mysql://root:password@localhost:3306/nutritrack"

# ---- External nutrition API ----
# Ported from the Android app's Retrofit base URL.
FRUITYVICE_BASE_URL="https://www.fruityvice.com/"

# ---- AI weekly summary (OPTIONAL) ----
# Leave unset to use the deterministic rule-based summary.
# The application is fully functional without this key.
# OPENAI_API_KEY="sk-..."
